{
  "name": "paypilot-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"node --watch server/index.js\"",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.js",
    "test": "npm run test:server && npm run test:rules",
    "test:server": "node --test server/*.test.js",
    "test:rules": "firebase emulators:exec --project demo-paypilot-security-rules --only firestore \"node --test rules-tests/firestore.rules.test.js\"",
    "reconcile": "node server/reconcile.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-tools": "^14.25.0"
  }
}
