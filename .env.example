# Copy to .env. Sandbox credentials only; never commit .env.
PORT=3001
APP_ORIGIN=http://localhost:5173
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional compliant external discovery through eBay Browse API.
# External offers always link out to the retailer and never use PayPilot checkout.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=sandbox
EBAY_MARKETPLACE_ID=EBAY_US
# Required for trusted API authorization and server-side payment persistence.
# These are secret server credentials; use a secret manager in production.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
# PayPal remains unavailable when credentials are unset. No simulated payment is created.

# Firebase web config (these are public client config values, not server secrets).
# Copy these VITE_ values into your local .env after registering a Firebase Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
